{
  "specification_version": "phase4-7-v1",
  "frozen_before_rank_inspection": true,
  "scoring": {
    "method": "transparent_weighted_percentile_index",
    "score_scale": 100,
    "normalization": "empirical_percentile_rank_average_ties",
    "tie_break": ["priority_index_desc", "crash_count_desc", "location_id_asc"],
    "weights": {
      "burden": 0.40,
      "vulnerable_road_user": 0.25,
      "temporal_concentration": 0.15,
      "school_proximity": 0.20,
      "exposure": 0.0
    },
    "raw_formulas": {
      "burden": "crash_count + 10*fatalities + 5*suspected_serious_injuries + people_injured",
      "vulnerable_road_user": "4*pedestrian_involved_crashes + 3*bicycle_involved_crashes + 10*pedestrian_fatalities + 2*pedestrians_injured",
      "temporal_concentration": "0.5*hour_bin_concentration + 0.5*weekday_concentration",
      "school_proximity": "exp(-nearest_school_distance_m/500)",
      "exposure": "disabled because the ADT source is transfer-limited"
    }
  },
  "validation": {
    "alpha": 0.05,
    "confidence_level": 0.95,
    "bootstrap_iterations": 1000,
    "minimum_events_per_location_per_temporal_block": 5,
    "temporal_blocks": [
      {"id": "2016_2018", "start": "2016-01-01", "end": "2018-12-31"},
      {"id": "2019_2021", "start": "2019-01-01", "end": "2021-12-31"},
      {"id": "2022_2025", "start": "2022-01-01", "end": "2025-12-31"}
    ],
    "temporal_spearman_threshold": 0.70,
    "top10_jaccard_threshold": 0.60,
    "manual_audit_minimum_agreement": 0.98,
    "manual_audit_wilson_lower_bound": 0.90,
    "manual_audit_cap": 100,
    "spatial_jaccard_mapping": "map each alternative-grid top-10 centroid into the frozen 250m primary grid, then compare unique primary IDs",
    "pandemic_sensitivity_excluded_years": [2020],
    "fdr_method": "Benjamini-Hochberg",
    "fdr_q": 0.05
  },
  "publication": {
    "top_n": 100,
    "web_record_limit": 1609,
    "limitation": "Historical prioritization aid; not a legal, causal, camera-deployment, or eligibility determination."
  }
}
